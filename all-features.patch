+                    isSelected && calStyles.dotSelected,
+                  ]}
+                />
+              )}
+            </TouchableOpacity>
+          );
+        })}
+      </View>
+
+      {/* Séances du jour sélectionné */}
+      {selectedDate && (
+        <View style={calStyles.dayDetail}>
+          <Text style={calStyles.dayDetailTitle}>
+            {dayjs(selectedDate).format('dddd D MMMM')}
