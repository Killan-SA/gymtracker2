+                  key={s.id}
+                  session={s}
+                  onPress={() => onPressSession(s.id)}
+                  onDelete={() => onDeleteSession(s)}
+                />
+              ))}
+            </View>
+          )}
+        </View>
+      )}
+    </ScrollView>
+  );
+}
